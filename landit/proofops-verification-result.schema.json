{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofops.dev/schemas/verification-result-v1.json",
  "title": "ProofOps Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "taskId",
    "repository",
    "environment",
    "commitSha",
    "status",
    "checks",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "format": "uuid" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "environment": { "enum": ["develop", "prod"] },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "status": { "enum": ["passed", "failed", "unobservable"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "summary"],
        "properties": {
          "name": { "enum": ["deployment", "ecs", "alb", "api", "sentry"] },
          "status": {
            "enum": ["passed", "failed", "unobservable", "skipped"]
          },
          "evidenceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "not": {
              "pattern": "(AKIA[0-9A-Z]{16}|github_pat_|gh[pousr]_|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|Bearer[ \\t]+[A-Za-z0-9._~+/=-]{10,}|(password|passwd|secret|token|api[_-]?key|aws_access_key_id|aws_secret_access_key)[ \\t]*[:=][ \\t]*[^ \\t]+)"
            }
          }
        }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}
