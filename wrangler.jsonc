{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofops",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proofops-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "local"
  }
}
