{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofops",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proofops-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "ProofOpsMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProofOpsMcp"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "SENTRY_ORG_SLUG": "landit",
    "SENTRY_PROJECT_SLUG": "proofops"
  }
}
