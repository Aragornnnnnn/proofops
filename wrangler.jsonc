{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proofops",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proofops",
      "database_id": "79d1de67-f18d-46b4-a672-df2c232ba553",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "cda3cf7d082d4fdf8e66313a30852bc3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "ProofOpsMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProofOpsMcp"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SENTRY_ORG_SLUG": "landit",
    "SENTRY_PROJECT_SLUG": "proofops"
  }
}
